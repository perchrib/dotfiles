tap "azure/kubelogin", "https://github.com/Azure/homebrew-kubelogin"
tap "bjarneo/cliamp"
tap "nrkno/hylla"
tap "oven-sh/bun"
tap "raine/workmux"
# Microsoft Azure CLI 2.0
brew "azure-cli"
# Resource monitor. C++ version and continuation of bashtop and bpytop
brew "btop"
# DuckDuckGo from the terminal
brew "ddgr"
# TIFF library and utilities
brew "libtiff"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Command-line fuzzy finder written in Go
brew "fzf"
# GitHub command-line tool
brew "gh"
# Interpreter for PostScript and PDF
brew "ghostscript"
# Syntax-highlighting pager for git and diff output
brew "git-delta"
# Render markdown on the CLI
brew "glow"
# Tools and libraries to manipulate images in select formats
brew "imagemagick"
# Feature-rich interactive Jira CLI
brew "jira-cli"
# Lightweight and flexible command-line JSON processor
brew "jq"
# Tool that can switch between kubectl contexts easily and create aliases
brew "kubectx"
# Kubernetes command-line interface
brew "kubernetes-cli"
# LastPass command-line interface tool
brew "lastpass-cli"
# Simple terminal UI for git commands
brew "lazygit"
# Library to render SVG files using Cairo
brew "librsvg"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Open-source, cross-platform JavaScript runtime environment
brew "node@24", link: true
# Manage multiple Node.js versions
brew "nvm"
# Create, run, and share large language models (LLMs)
brew "ollama", restart_service: :changed
# Python version management
brew "pyenv"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Microsoft SQL Server command-line interface
brew "sqlcmd"
# Organize software neatly under a single directory tree (e.g. /usr/local)
brew "stow"
# Official tldr client written in Rust
brew "tlrc"
# Terminal multiplexer
brew "tmux"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Command-line client for WebSockets
brew "websocat"
# A retro terminal music player inspired by Winamp 2.x
brew "bjarneo/cliamp/cliamp", trusted: true
# Opinionated workflow tool that orchestrates git worktrees and tmux
brew "raine/workmux/workmux", trusted: true
# Terminal interface for Antigravity agents
cask "antigravity-cli"
# Anthropic's official Claude AI desktop app
cask "claude"
# Terminal-based AI coding assistant
cask "claude-code"
# Brings the power of Copilot coding agent directly to your terminal
cask "copilot-cli"
# Universal database tool and SQL client
cask "dbeaver-community"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Developer platform
cask "dotnet-sdk"
cask "font-fira-code-nerd-font"
cask "font-jetbrains-mono"
cask "font-maple-mono"
# GPU-based terminal emulator
cask "kitty"
# Application launcher
cask "leader-key"
# Get up and running with large language models locally
cask "ollama-app"
# Dictation tool including LLM reformatting
cask "superwhisper"
# Window manager
cask "tiles"
npm "corepack"
